[
  {
    "id": "tab_sala101",
    "type": "tab",
    "label": "Sala 101 - Temperatura",
    "disabled": false,
    "info": "Fluxo IoT F054: MQTT + regra + armazenamento. Dashboard visual em /dashboard (HTML)."
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "HiveMQ Public",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "unifor-sala101-nodered",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": 60,
    "cleansession": true
  },
  {
    "id": "mqtt_in_temp",
    "type": "mqtt in",
    "z": "tab_sala101",
    "name": "Telemetria ESP32",
    "topic": "unifor/sala101/temperatura",
    "qos": "0",
    "datatype": "utf8",
    "broker": "mqtt_broker",
    "x": 150,
    "y": 140,
    "wires": [["json_parse"]]
  },
  {
    "id": "json_parse",
    "type": "json",
    "z": "tab_sala101",
    "name": "Parse JSON",
    "property": "payload",
    "action": "",
    "pretty": false,
    "x": 360,
    "y": 140,
    "wires": [["fn_processar", "debug_raw"]]
  },
  {
    "id": "debug_raw",
    "type": "debug",
    "z": "tab_sala101",
    "name": "Debug leitura",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.temperatura",
    "statusType": "msg",
    "x": 580,
    "y": 60,
    "wires": []
  },
  {
    "id": "fn_processar",
    "type": "function",
    "z": "tab_sala101",
    "name": "Contar leituras",
    "func": "const dados = msg.payload;\nlet contador = context.get('contador') || 0;\ncontador += 1;\ncontext.set('contador', contador);\nmsg.contador = contador;\nmsg.temperatura = dados.temperatura;\nmsg.umidade = dados.umidade;\nmsg.ventilador = dados.ventilador;\nmsg.limite = dados.limite || 28;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 580,
    "y": 140,
    "wires": [["fn_regra", "fn_salvar", "debug_count"]]
  },
  {
    "id": "debug_count",
    "type": "debug",
    "z": "tab_sala101",
    "name": "Contador",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "contador",
    "targetType": "msg",
    "statusVal": "contador",
    "statusType": "msg",
    "x": 800,
    "y": 60,
    "wires": []
  },
  {
    "id": "fn_regra",
    "type": "function",
    "z": "tab_sala101",
    "name": "Regra automática",
    "func": "const temp = msg.temperatura;\nconst limite = msg.limite || 28;\nif (temp > limite) {\n  msg.payload = { ventilador: 'on', motivo: 'temperatura_alta', temperatura: temp, limite: limite };\n  msg.alerta = true;\n} else {\n  msg.payload = { ventilador: 'off', motivo: 'temperatura_ok', temperatura: temp, limite: limite };\n  msg.alerta = false;\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 810,
    "y": 140,
    "wires": [["mqtt_out_cmd", "debug_regra"]]
  },
  {
    "id": "mqtt_out_cmd",
    "type": "mqtt out",
    "z": "tab_sala101",
    "name": "Comando ventilador",
    "topic": "unifor/sala101/comando",
    "qos": "0",
    "retain": "",
    "broker": "mqtt_broker",
    "x": 1050,
    "y": 120,
    "wires": []
  },
  {
    "id": "debug_regra",
    "type": "debug",
    "z": "tab_sala101",
    "name": "Debug regra",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 1030,
    "y": 180,
    "wires": []
  },
  {
    "id": "fn_salvar",
    "type": "function",
    "z": "tab_sala101",
    "name": "Preparar CSV",
    "func": "msg.payload = [msg.contador, new Date().toISOString(), msg.temperatura, msg.umidade, msg.ventilador].join(',') + '\\n';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 800,
    "y": 240,
    "wires": [["file_out"]]
  },
  {
    "id": "file_out",
    "type": "file",
    "z": "tab_sala101",
    "name": "Salvar leituras",
    "filename": "/Users/gabrielmonteiro/Developer/f054-iot-sala-temperatura/nodered-data/leituras_sala101.csv",
    "filenameType": "str",
    "appendNewline": false,
    "createDir": false,
    "overwriteFile": "false",
    "encoding": "utf8",
    "x": 1030,
    "y": 240,
    "wires": [[]]
  },
  {
    "id": "btn_teste",
    "type": "inject",
    "z": "tab_sala101",
    "name": "Teste manual 29.5C",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"sala\":\"101\",\"temperatura\":29.5,\"umidade\":58,\"limite\":28,\"ventilador\":\"ligado\",\"unidade\":\"C\",\"ts\":0}",
    "payloadType": "json",
    "x": 160,
    "y": 240,
    "wires": [["fn_processar"]]
  },
  {
    "id": "comment_help",
    "type": "comment",
    "z": "tab_sala101",
    "name": "Dashboard visual",
    "info": "Abra o dashboard HTML em http://127.0.0.1:5500\nEste fluxo Node-RED recebe MQTT, aplica regra, salva CSV (>=20 leituras) e publica comando.",
    "x": 140,
    "y": 40,
    "wires": []
  }
]
